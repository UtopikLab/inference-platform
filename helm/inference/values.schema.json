{
    "$schema": "https://json-schema.org/schema",
    "definitions": {
        "secretReference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "key"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 253,
                    "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[-._A-Za-z0-9]+$"
                }
            }
        },
        "resourceList": {
            "type": "object",
            "patternProperties": {
                "^[A-Za-z0-9][A-Za-z0-9.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)?$": {
                    "type": [
                        "string",
                        "integer",
                        "number"
                    ]
                }
            },
            "additionalProperties": false
        },
        "inferenceResources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "requests": {
                    "$ref": "#/definitions/resourceList"
                },
                "limits": {
                    "$ref": "#/definitions/resourceList"
                }
            }
        },
        "inferenceServer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "replicas",
                "service"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 63,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "replicas": {
                    "type": "integer",
                    "minimum": 1
                },
                "modelDir": {
                    "type": "string",
                    "pattern": "^/[^.]*[^/]$"
                },
                "modelArgs": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "serverArgs": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "nodeSelector": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "resources": {
                    "$ref": "#/definitions/inferenceResources"
                },
                "service": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "port"
                    ],
                    "properties": {
                        "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                        }
                    }
                }
            }
        },
        "ingressRoute": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "host",
                "path",
                "profile"
            ],
            "properties": {
                "host": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[A-Za-z0-9*]([A-Za-z0-9*.-]*[A-Za-z0-9*])?$"
                },
                "path": {
                    "type": "string",
                    "pattern": "^/"
                },
                "pathType": {
                    "type": "string",
                    "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                    ]
                },
                "profile": {
                    "type": "string",
                    "maxLength": 63,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
            }
        },
        "inferenceTls": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "hosts",
                "secretName"
            ],
            "properties": {
                "hosts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253
                    }
                },
                "secretName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
            }
        },
        "inferenceIngress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "routes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ingressRoute"
                    }
                },
                "className": {
                    "type": "string"
                },
                "annotations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "tls": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/inferenceTls"
                    }
                },
                "certManager": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "issuerName": {
                            "type": "string",
                            "maxLength": 253
                        },
                        "issuerKind": {
                            "type": "string",
                            "enum": [
                                "Issuer",
                                "ClusterIssuer"
                            ]
                        }
                    },
                    "if": {
                        "properties": {
                            "enabled": {
                                "const": true
                            }
                        },
                        "required": [
                            "enabled"
                        ]
                    },
                    "then": {
                        "required": [
                            "issuerName"
                        ],
                        "properties": {
                            "issuerName": {
                                "minLength": 1
                            }
                        }
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "enabled": {
                                "const": true
                            }
                        },
                        "required": [
                            "enabled"
                        ]
                    },
                    "then": {
                        "required": [
                            "routes"
                        ],
                        "properties": {
                            "routes": {
                                "minItems": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "certManager": {
                                "properties": {
                                    "enabled": {
                                        "const": true
                                    }
                                },
                                "required": [
                                    "enabled"
                                ]
                            }
                        },
                        "required": [
                            "certManager"
                        ]
                    },
                    "then": {
                        "required": [
                            "tls"
                        ],
                        "properties": {
                            "tls": {
                                "minItems": 1
                            }
                        }
                    }
                }
            ]
        }
    },
    "title": "inference values",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "secretRefs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "githubAppKey",
                "managementServiceToken",
                "supervisorServiceToken",
                "openaiApiKey",
                "coderApiKey",
                "managementAdminPassword",
                "managementGithubClientSecret"
            ],
            "properties": {
                "githubAppKey": {
                    "$ref": "#/definitions/secretReference"
                },
                "managementServiceToken": {
                    "$ref": "#/definitions/secretReference"
                },
                "supervisorServiceToken": {
                    "$ref": "#/definitions/secretReference"
                },
                "openaiApiKey": {
                    "$ref": "#/definitions/secretReference"
                },
                "coderApiKey": {
                    "$ref": "#/definitions/secretReference"
                },
                "managementAdminPassword": {
                    "$ref": "#/definitions/secretReference"
                },
                "managementGithubClientSecret": {
                    "$ref": "#/definitions/secretReference"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                    }
                }
            }
        },
        "inference": {
            "type": "object",
            "properties": {
                "pv": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "create": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string",
                            "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 63
                        },
                        "nodeName": {
                            "type": "string"
                        },
                        "path": {
                            "type": "string",
                            "pattern": "^$|^/"
                        }
                    },
                    "if": {
                        "properties": {
                            "create": {
                                "const": true
                            }
                        },
                        "required": [
                            "create"
                        ]
                    },
                    "then": {
                        "required": [
                            "nodeName",
                            "path"
                        ],
                        "properties": {
                            "nodeName": {
                                "minLength": 1
                            },
                            "path": {
                                "minLength": 2,
                                "pattern": "^/"
                            }
                        }
                    }
                },
                "pvc": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 63,
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                        },
                        "storage": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei)$"
                        },
                        "volumeName": {
                            "type": "string",
                            "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                            "maxLength": 63
                        },
                        "storageClassName": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "imagePullSecrets": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "name"
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 253,
                                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                            }
                        }
                    }
                },
                "servers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/inferenceServer"
                    }
                },
                "ingress": {
                    "$ref": "#/definitions/inferenceIngress"
                },
                "modelSource": {
                    "description": "Removed: requesters select HF models through the native router API, not deployment values.",
                    "not": {}
                },
                "gpuCount": {
                    "not": {}
                },
                "configMaps": {
                    "not": {}
                }
            }
        },
        "global": {
            "type": "object",
            "properties": {
                "IMAGE_REGISTRY": {
                    "type": "string"
                }
            }
        },
        "IMAGE": {
            "type": "string"
        },
        "WORKER_IMAGE": {
            "type": "string"
        },
        "namespaces": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean"
                },
                "inference": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                },
                "orchestrator": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "labels": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "nvidia-device-plugin": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "allowDefaultNamespace": {
                    "type": "boolean"
                },
                "namespaceOverride": {
                    "type": "string"
                }
            }
        },
        "orchestrator": {
            "type": "object",
            "properties": {
                "image": {
                    "type": "string"
                },
                "imagePullPolicy": {
                    "type": "string"
                },
                "real": {
                    "type": "boolean"
                },
                "verified": {
                    "type": "string"
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "max-iterations": {
                            "type": "string"
                        },
                        "task-wait-seconds": {
                            "type": "string"
                        },
                        "loop-state-dir": {
                            "type": "string"
                        },
                        "judge-url": {
                            "type": "string"
                        },
                        "judge-model": {
                            "type": "string"
                        }
                    }
                },
                "judge": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                },
                "ingress": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "ingressClassName": {
                            "type": "string"
                        },
                        "entrypoints": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}